# Server
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://max-sport.sabirov.tech
BOT_USERNAME=gov_max_sport_bot

# MAX Bot (never commit real values)
MAX_BOT_TOKEN=
WEBHOOK_SECRET=

# Optional second transport (not for pitch)
TELEGRAM_BOT_TOKEN=

# Database
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://maxsport:change_me@postgres:5432/maxsport

# Redis
REDIS_URL=redis://redis:6379

# Yandex Maps. Separate products, separate keys in the Yandex cabinet.
# Only the JS API key reaches the browser (restricted there by HTTP referrer);
# the other three are proxied through /api/geo/* and must never be exposed.
# A new key takes up to 15 minutes to activate.
YANDEX_MAPS_JS_API_KEY=
YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_STATIC_API_KEY=

# Docker deploy (CI sets IMAGE_TAG=sha-<commit> on the server)
IMAGE_TAG=local
