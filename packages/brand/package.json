{
  "name": "@maxsport/brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./tailwind.css": "./tailwind.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "tokens.css",
    "tailwind.css",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
