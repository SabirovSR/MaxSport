{
  "name": "@maxsport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@maxsport/chat-card": "*",
    "@maxsport/karma": "*",
    "@maxsport/lobby": "*",
    "@maxsport/max-channel": "*",
    "@maxsport/notifications": "*",
    "@maxsport/payment": "*",
    "@maxsport/presence": "*",
    "@maxsport/realtime": "*",
    "@maxsport/shared": "*",
    "@maxsport/venue": "*",
    "fastify": "^5.2.1",
    "@fastify/static": "^8.0.4",
    "@fastify/cors": "^10.0.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
